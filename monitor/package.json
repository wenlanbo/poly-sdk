{
  "name": "prediction-market-monitor",
  "version": "1.0.0",
  "description": "Background service for monitoring Polymarket and Kalshi markets with Slack notifications and Supabase storage",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:polymarket": "node dist/index.js",
    "start:kalshi": "node dist/kalshi-index.js",
    "start:both": "concurrently \"npm run start:polymarket\" \"npm run start:kalshi\"",
    "dev": "tsx src/index.ts",
    "dev:kalshi": "tsx src/kalshi-index.ts",
    "watch": "tsx watch src/index.ts",
    "watch:kalshi": "tsx watch src/kalshi-index.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "polymarket",
    "kalshi",
    "prediction-markets",
    "monitor",
    "notifications",
    "slack",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@catalyst-team/poly-sdk": "^0.4.0",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
