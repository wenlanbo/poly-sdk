{
  "name": "polymarket-monitor",
  "version": "1.0.0",
  "description": "Background service for monitoring new Polymarket markets with Slack notifications and Supabase storage",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "polymarket",
    "monitor",
    "notifications",
    "slack",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@catalyst-team/poly-sdk": "file:..",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
