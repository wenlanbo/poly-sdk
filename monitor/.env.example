# ============================================================================
# Polymarket Market Monitor - Environment Configuration
# ============================================================================
#
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it contains secrets!)
#

# ============================================================================
# REQUIRED: Supabase Configuration
# ============================================================================
# Get these from: https://app.supabase.com → Your Project → Settings → API
#
# IMPORTANT: Use the service_role key (NOT the anon key!)
# The service_role key has full database access needed for this monitor

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ============================================================================
# Slack Notifications
# ============================================================================
# Get webhook URL from: https://api.slack.com/messaging/webhooks
#
# Steps:
# 1. Go to https://api.slack.com/apps
# 2. Create a new app or select existing
# 3. Go to "Incoming Webhooks" and activate
# 4. Click "Add New Webhook to Workspace"
# 5. Select the channel and copy the webhook URL

SLACK_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# Market Filtering (Optional)
# ============================================================================
# Set ENABLE_FILTERING=true to activate filtering
# Leave as false to monitor ALL markets

ENABLE_FILTERING=false

# Filter by categories (comma-separated)
# Example: crypto,sports,politics
# FILTER_CATEGORIES=crypto,politics

# Filter by keywords in market question (comma-separated)
# Example: Bitcoin,Trump,election
# FILTER_KEYWORDS=Bitcoin,Ethereum

# Filter by minimum liquidity (USD)
# FILTER_MIN_LIQUIDITY=1000

# Filter by minimum volume (USD)
# FILTER_MIN_VOLUME=500

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
